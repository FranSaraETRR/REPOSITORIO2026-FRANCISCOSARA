#include <stdio.h>

int main() {
    int vector[5];
    int opcion = 0;
    int posicion;
    int i;

    for(i = 0; i < 5; i++) {
        printf("Ingrese un valor: ");
        scanf("%d", &vector[i]);
    }

    while(opcion != 4) {

        printf("\n1- Ver un valor\n");
        printf("2- Modificar un valor\n");
        printf("3- Imprimir vector\n");
        printf("4- Salir\n");
        printf("Opcion: ");
        scanf("%d", &opcion);

        if(opcion == 1) {
            printf("Ingrese la posicion (1 a 5): ");
            scanf("%d", &posicion);

            printf("El valor es: %d\n", vector[posicion - 1]);
        }

        if(opcion == 2) {
            printf("Ingrese la posicion a modificar (1 a 5): ");
            scanf("%d", &posicion);

            printf("Ingrese el nuevo valor: ");
            scanf("%d", &vector[posicion - 1]);
        }

        if(opcion == 3) {
            printf("Vector:\n");

            for(i = 0; i < 5; i++) {
                printf("%d\n", vector[i]);
            }
        }
    }

    return 0;
}
