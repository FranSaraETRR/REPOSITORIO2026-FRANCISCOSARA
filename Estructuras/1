#include <stdio.h>

struct Alumno {
    char nombre[30];
    int edad;
    int año;
};

int main() {
    struct Alumno alumno = {"Fran", 16, 4};

    printf("Datos originales:\n");
    printf("Nombre: %s\n", alumno.nombre);
    printf("Edad: %d\n", alumno.edad);
    printf("Año: %d\n", alumno.año);

    printf("\nIngrese un nuevo nombre: ");
    scanf("%s", alumno.nombre);

    printf("Ingrese una nueva edad: ");
    scanf("%d", &alumno.edad);

    printf("Ingrese un nuevo año: ");
    scanf("%d", &alumno.año);

    printf("\nDatos modificados:\n");
    printf("Nombre: %s\n", alumno.nombre);
    printf("Edad: %d\n", alumno.edad);
    printf("Año: %d\n", alumno.año);

    return 0;
}
