#include <stdio.h>

int main() {
    int matriz[3][2];
    int fila, columna;

    for(fila = 0; fila < 3; fila++) {
        for(columna = 0; columna < 2; columna++) {
            printf("Ingrese un valor: ");
            scanf("%d", &matriz[fila][columna]);
        }
    }

    printf("\nMatriz:\n");

    for(fila = 0; fila < 3; fila++) {
        for(columna = 0; columna < 2; columna++) {
            printf("%d ", matriz[fila][columna]);
        }
        printf("\n");
    }

    return 0;
}
