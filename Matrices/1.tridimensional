#include <stdio.h>

int main() {
    int matriz[2][3][2];
    int i, j, k;

    for(i = 0; i < 2; i++) {
        for(j = 0; j < 3; j++) {
            for(k = 0; k < 2; k++) {
                printf("Ingrese un valor: ");
                scanf("%d", &matriz[i][j][k]);
            }
        }
    }

    printf("\nMatriz tridimensional:\n");

    for(i = 0; i < 2; i++) {
        printf("Capa %d:\n", i + 1);

        for(j = 0; j < 3; j++) {
            for(k = 0; k < 2; k++) {
                printf("%d ", matriz[i][j][k]);
            }
            printf("\n");
        }
    }

    return 0;
}
