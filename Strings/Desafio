#include <stdlib.h>
#include <string.h>

int main() {
    char opcion[20];

    printf("Escriba 'continuar' o 'finalizar': ");
    scanf("%s", opcion);

    while(strcmp(opcion, "finalizar") != 0) {

        if(strcmp(opcion, "continuar") == 0) {
            printf("El programa continua.\n");
        }
        else {
            printf("ERROR: opcion no valida.\n");
        }

        printf("Escriba 'continuar' o 'finalizar': ");
        scanf("%s", opcion);
    }

    printf("Programa finalizado.\n");

    return 0;
}
